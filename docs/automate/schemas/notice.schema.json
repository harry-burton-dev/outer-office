{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harry-burton-dev/outer-office/blob/main/docs/automate/schemas/notice.schema.json",
  "title": "Call notice (app to orchestrator)",
  "$ref": "envelope.schema.json",
  "type": "object",
  "properties": {
    "kind": { "const": "call" },
    "callId": { "$ref": "envelope.schema.json#/$defs/callId" },
    "api": { "$ref": "envelope.schema.json#/$defs/name" },
    "apiVersion": { "$ref": "envelope.schema.json#/$defs/version" },
    "input": { "type": "object", "description": "The API's input, inline. Validated by that API's own input schema." },
    "caller": {
      "type": "object",
      "properties": { "user": { "type": "string" }, "app": { "type": "string" } },
      "required": ["user", "app"],
      "additionalProperties": false
    },
    "issuedAt": { "$ref": "envelope.schema.json#/$defs/isoUtc" },
    "expiresAt": { "$ref": "envelope.schema.json#/$defs/isoUtc" }
  },
  "required": ["protocol", "version", "kind", "callId", "api", "apiVersion", "input", "caller", "issuedAt", "expiresAt"],
  "unevaluatedProperties": false
}
